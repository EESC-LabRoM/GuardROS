<?xml version="1.0"?>
<package format="3">
  <name>rb23_telemetry_viewer</name>
  <version>0.0.1</version>
  <description>Viewer textual de telemetria para o GuardROS / RollerBot 23.</description>

  <maintainer email="denis.mosconi@ifsp.edu.br">denis</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>guardros_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>